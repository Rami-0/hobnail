# Supply-chain policy (owner decision D3, docs/plans/react-port.md):
# no package version younger than 7 days, no install scripts.
# D2 permits only @ui-sdk/*; installed with a one-command age override.
# Locked SDK versions are explicitly reviewed in scripts/ages.mjs.
min-release-age=7
ignore-scripts=true
save-exact=true
engine-strict=true
fund=false
